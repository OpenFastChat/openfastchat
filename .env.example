# Postgres (the docker compose db service). pgvector is required (RAG).
OFC_DATABASE_URL=postgres://openfastchat:openfastchat@localhost:5432/openfastchat?sslmode=disable

# Providers (Groq, DeepSeek, a local vLLM/Ollama server, …) are NOT set here.
# Add them at /admin: enter each OpenAI-compatible endpoint's base URL + key.
# They are stored encrypted in the DB, so you never touch this file for them.

# Self-host is single-user: the visitor is the admin, so /admin needs no
# token. Keep a public instance behind your own network/proxy auth.

# Master key that encrypts provider keys at rest (base64 32 bytes:
# `openssl rand -base64 32`). Leave blank to auto-generate an ephemeral key,
# but then stored keys are lost on restart — set this in production.
OFC_PROVIDER_ENCRYPTION_KEY=

# Optional: web-search node (Brave), context-compaction model.
# OFC_BRAVE_API_KEY=
# OFC_COMPACT_MODEL=llama-3.1-8b-instant

# Signs session cookies. Leave blank to auto-generate an ephemeral secret,
# but then sessions drop on restart — set a long random string in production.
OFC_JWT_SECRET=

# Address to listen on.
LISTEN_ADDR=127.0.0.1:8080

# Set true only behind a trusted reverse proxy that sets X-Forwarded-For.
# OFC_TRUST_FORWARDED_IP=false
